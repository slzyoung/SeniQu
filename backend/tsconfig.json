{
    "compilerOptions": {
        "module": "commonjs",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "target": "ES2021",
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": "./",
        "incremental": true,
        "skipLibCheck": true,
        "strictNullChecks": true,
        "noImplicitAny": true,
        "strictBindCallApply": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "paths": {
            "@/*": [
                "src/*"
            ],
            "@config/*": [
                "src/config/*"
            ],
            "@common/*": [
                "src/common/*"
            ],
            "@auth/*": [
                "src/auth/*"
            ],
            "@users/*": [
                "src/users/*"
            ],
            "@artworks/*": [
                "src/artworks/*"
            ],
            "@nfts/*": [
                "src/nfts/*"
            ],
            "@collections/*": [
                "src/collections/*"
            ],
            "@governance/*": [
                "src/governance/*"
            ]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}