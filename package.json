{
    "name": "seniqu-monorepo",
    "private": true,
    "workspaces": [
        "frontend",
        "backend",
        "contracts"
    ],
    "scripts": {
        "dev:frontend": "npm run dev -w @seniqu/frontend",
        "dev:backend": "npm run start:dev -w @seniqu/backend",
        "build:frontend": "npm run build -w @seniqu/frontend",
        "build:backend": "npm run build -w @seniqu/backend",
        "build": "npm run build --workspaces",
        "start": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    },
    "overrides": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "lodash": ">=4.17.24",
        "ws": ">=8.17.1",
        "protobufjs": ">=7.4.1",
        "postcss": ">=8.5.10",
        "picomatch": ">=4.0.4",
        "minimatch": ">=3.1.4",
        "tmp": ">=0.2.4",
        "serialize-javascript": ">=7.0.5",
        "js-yaml": ">=4.1.1"
    }
}